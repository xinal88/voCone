@@ -0,0 +1,166 @@
+"""Tests for the crowd velocity-obstacle cone pipeline: generator, space and AGENT_5_VO."""
+
+from __future__ import annotations
+
+import importlib.resources
+
+import numpy as np
+import pytest
+import torch
+import yaml
+
+from rosnav_rl.cfg.action_spaces import DifferentialDriveActionSpace
+from rosnav_rl.cfg.agent import AgentConfig
+from rosnav_rl.cfg.parameters import AgentParameters
+from rosnav_rl.model.stable_baselines3.cfg import PPO_Cfg, StableBaselinesCfg
+from rosnav_rl.model.stable_baselines3.cfg.ppo import PPO_Algorithm_Cfg
+from rosnav_rl.observations.data_sources.generators import (
+    CrowdTimeToContactGenerator,
+    CrowdVelocityObstacleConeGenerator,
+)
+from rosnav_rl.rl_agent import RL_Agent
+from rosnav_rl.spaces.observation_space.spaces.environment import CrowdVelocityObstacleConeSpace
+from rosnav_rl.utils.utils import make_mock_env
+
+PARAMS = AgentParameters(robot_radius=0.4)
+HEADINGS = 16
+MIRROR = np.mod(-np.arange(HEADINGS), HEADINGS)
+
+
+def _vo(locations, velocities, twist=(0.0, 0.0, 0.0), **kwargs):
+    return CrowdVelocityObstacleConeGenerator(name="crowd_vo", **kwargs)._generate(
+        np.asarray(locations, dtype=np.float32),
+        np.asarray(velocities, dtype=np.float32),
+        np.asarray(twist, dtype=np.float32),
+        PARAMS,
+    )
+
+
+def test_no_pedestrians_leaves_every_heading_free():
+    out = _vo(np.empty((0, 2)), np.empty((0, 2)))
+
+    assert out.shape == (HEADINGS,)
+    assert out.tolist() == [0.0] * HEADINGS
+
+
+def test_a_standing_pedestrian_ahead_blocks_only_the_forward_heading_at_the_speed_floor():
+    out = _vo([[2.0, 0.0]], [[0.0, 0.0]])
+
+    expected = np.zeros(HEADINGS)
+    expected[0] = 1.0 - ((2.0 - 0.7) / 0.3) / 5.0
+    np.testing.assert_allclose(out, expected, atol=1e-5)
+
+
+def test_the_measured_speed_brings_a_far_pedestrian_inside_the_horizon():
+    standing = _vo([[4.7, 0.0]], [[0.0, 0.0]])
+    driving = _vo([[4.7, 0.0]], [[0.0, 0.0]], twist=(1.0, 0.0, 0.0))
+
+    assert standing[0] == 0.0
+    assert driving[0] == pytest.approx(1.0 - 4.0 / 5.0, abs=1e-5)
+
+
+def test_an_oncoming_pedestrian_blocks_ahead_harder_than_behind():
+    out = _vo([[4.0, 0.0]], [[-1.0, 0.0]])
+
+    assert out[0] == pytest.approx(1.0 - (3.3 / 1.3) / 5.0, abs=1e-5)
+    assert out[8] == pytest.approx(1.0 - (3.3 / 0.7) / 5.0, abs=1e-5)
+    assert out[4] == 0.0 and out[12] == 0.0
+
+
+def test_pedestrians_beyond_the_range_are_ignored():
+    out = _vo([[13.0, 0.0]], [[-10.0, 0.0]])
+
+    assert not out.any()
+
+
+def test_a_pedestrian_in_contact_blocks_every_heading():
+    out = _vo([[0.5, 0.0]], [[0.0, 0.0]])
+
+    np.testing.assert_allclose(out, np.ones(HEADINGS))
+
+
+@pytest.mark.parametrize(("heading", "twist"), [(0, (0.8, 0.0, 0.0)), (4, (0.0, 0.8, 0.0)), (8, (-0.8, 0.0, 0.0))])
+def test_the_heading_of_travel_reads_the_time_to_contact_of_the_measured_velocity(heading, twist):
+    rng = np.random.default_rng(heading)
+    locations = rng.uniform(-6.0, 6.0, (8, 2))
+    velocities = rng.uniform(-1.2, 1.2, (8, 2))
+
+    cone = _vo(locations, velocities, twist=twist)
+    ttc = CrowdTimeToContactGenerator(name="crowd_ttc", horizon=5.0)._generate(
+        locations, velocities, np.asarray(twist), PARAMS
+    )
+
+    assert cone[heading] == pytest.approx(1.0 - ttc[0] / 5.0, abs=1e-5)
+
+
+def test_a_scene_mirrored_across_the_forward_axis_mirrors_the_headings():
+    rng = np.random.default_rng(7)
+    locations = rng.uniform(-6.0, 6.0, (10, 2))
+    velocities = rng.uniform(-1.2, 1.2, (10, 2))
+    flip = np.array([1.0, -1.0])
+
+    out = _vo(locations, velocities, twist=(0.6, 0.2, 0.0))
+    mirrored = _vo(locations * flip, velocities * flip, twist=(0.6, -0.2, 0.0))
+
+    assert out.any()
+    np.testing.assert_allclose(mirrored, out[MIRROR], atol=1e-6)
+
+
+def test_space_clips_into_the_unit_box_and_normalizes():
+    space = CrowdVelocityObstacleConeSpace(normalize=False)
+    raw = np.linspace(-0.5, 1.5, HEADINGS, dtype=np.float32)
+
+    encoded = space.encode_observation(raw)
+
+    assert space.space.shape == (HEADINGS,)
+    np.testing.assert_allclose(encoded, np.clip(raw, 0.0, 1.0), atol=1e-6)
+    normalized = CrowdVelocityObstacleConeSpace(normalize=True).encode_observation(raw)
+    assert normalized.min() >= -1.0 and normalized.max() <= 1.0
+    assert normalized[0] < normalized[-1]
+
+
+def _vo_agent() -> RL_Agent:
+    return RL_Agent(
+        AgentConfig(
+            name="vo_agent",
+            action_space=DifferentialDriveActionSpace(linear_range=(-0.5, 1.0), angular_range=(-1.0, 1.0)),
+            parameters=AgentParameters(laser_num_beams=720, robot_radius=0.4),
+            framework=StableBaselinesCfg(
+                algorithm=PPO_Cfg(architecture_name="AGENT_5_VO", parameters=PPO_Algorithm_Cfg(device="cpu"))
+            ),
+        )
+    )
+
+
+def test_bundled_observations_provide_what_the_vo_agent_requires():
+    agent = _vo_agent()
+    config = yaml.safe_load((importlib.resources.files("rosnav_rl") / "observations" / "observations.yaml").read_text())
+    provided = (set(config["datasources"]) - set(config["aliases"].values())) | set(config["aliases"]) | {"is_terminal"}
+
+    required = {
+        key for keys in agent.space_manager.observation_space_manager.required_observations.values() for key in keys
+    }
+
+    assert required <= provided
+    assert config["datasources"]["crowd_vo"]["type"] == "CrowdVelocityObstacleConeGenerator"
+
+
+def test_vo_agent_head_reads_the_scalars_next_to_the_robot_state():
+    agent = _vo_agent()
+    agent.initialize_model(make_mock_env(ns="", space_manager=agent.space_manager))
+    extractor = agent.model.model.policy.features_extractor
+    observation = {
+        key: np.zeros((1, *space.shape), dtype=np.float32)
+        for key, space in agent.space_manager.observation_space.spaces.items()
+    }
+
+    blocked = dict(observation, CrowdVelocityObstacleConeSpace=np.ones((1, HEADINGS), dtype=np.float32))
+
+    extractor.eval()
+    with torch.no_grad():
+        free_features = extractor({k: torch.as_tensor(v) for k, v in observation.items()})
+        blocked_features = extractor({k: torch.as_tensor(v) for k, v in blocked.items()})
+
+    assert "CrowdTimeToContactSpace" not in agent.space_manager.observation_space.spaces
+    assert extractor._last_action_size == agent.space_manager.observation_space["LastActionSpace"].shape[-1] + HEADINGS
+    assert not torch.allclose(free_features, blocked_features)
