+class CrowdVelocityObstacleConeGenerator(Generator[CrowdVelocityObstacleCone]):
+    """Velocity-obstacle cone: per heading at the measured speed (floored at `min_speed`), the largest `1 - t / horizon` over pedestrians in contact before `horizon`."""
+
+    requires = {
+        "pedestrian_relative_locations": PedestrianRelativeLocations,
+        "pedestrian_relative_velocities": PedestrianRelativeVelocities,
+        "robot_twist": RobotVelocity,
+    }
+
+    def __init__(
+        self,
+        name: str,
+        pedestrian_radius: float = 0.3,
+        horizon: float = 5.0,
+        max_range: float = 12.0,
+        num_headings: int = 16,
+        min_speed: float = 0.3,
+        **kwargs: Any,
+    ):
+        super().__init__(name, **kwargs)
+        self.pedestrian_radius = pedestrian_radius
+        self.horizon = horizon
+        self.max_range = max_range
+        self.num_headings = num_headings
+        self.min_speed = min_speed
+        angles = 2.0 * np.pi * np.arange(num_headings) / num_headings
+        self._headings = np.stack((np.cos(angles), np.sin(angles)), axis=1)
+
+    def _generate(
+        self,
+        pedestrian_relative_locations: PedestrianRelativeLocations,
+        pedestrian_relative_velocities: PedestrianRelativeVelocities,
+        robot_twist: RobotVelocity,
+        simulation_state_container: AgentParameters,
+        **kwargs: Any,
+    ) -> CrowdVelocityObstacleCone:
+        out = np.zeros(self.num_headings, dtype=np.float32)
+        if len(pedestrian_relative_locations) == 0 or len(pedestrian_relative_velocities) == 0:
+            return out
+        positions = np.asarray(pedestrian_relative_locations, dtype=np.float64).reshape(-1, 2)
+        velocities = np.asarray(pedestrian_relative_velocities, dtype=np.float64).reshape(-1, 2)
+        in_range = np.hypot(positions[:, 0], positions[:, 1]) <= self.max_range
+        positions, velocities = positions[in_range], velocities[in_range]
+        if len(positions) == 0:
+            return out
+        speed = max(float(np.hypot(robot_twist[0], robot_twist[1])), self.min_speed)
+        relative = velocities[None, :, :] - speed * self._headings[:, None, :]
+        ttc = time_to_contact(
+            np.broadcast_to(positions, relative.shape).reshape(-1, 2),
+            relative.reshape(-1, 2),
+            contact_radius=simulation_state_container.robot_radius + self.pedestrian_radius,
+            horizon=self.horizon,
+        ).reshape(self.num_headings, -1)
+        blocked = np.where(ttc < self.horizon, 1.0 - ttc / self.horizon, 0.0)
+        out[:] = blocked.max(axis=1)
+        return out
